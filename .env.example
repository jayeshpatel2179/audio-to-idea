# content as a single line here instead of using GOOGLE_SERVICE_ACCOUNT_FILE. If set, this takes priority.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=your_google_sheet_id_from_the_sheet_url
GOOGLE_SHEET_NAME=Sheet1
